# Copy to .env; never commit real secrets.
RA_DATA_DIR=data
RA_CHAT_MODEL=openai/gpt-4o-mini
RA_CHAT_BASE_URL=https://api.openai.com/v1
RA_CHAT_API_KEY=
RA_EMBEDDING_BACKEND=api
RA_EMBEDDING_MODEL=text-embedding-3-small
RA_EMBEDDING_BASE_URL=https://api.openai.com/v1
RA_EMBEDDING_API_KEY=
RA_TOP_K=6
RA_TIMEOUT_SECONDS=90
RA_MAX_UPLOAD_BYTES=20971520
RA_MAX_PDF_PAGES=500
RA_CHUNK_CHARS=1400
RA_CHUNK_OVERLAP=150
RA_MCP_URL=
RA_MCP_TOOL=search_papers
RA_MAX_TOOL_CALLS=1
RA_GRAPH_RECURSION_LIMIT=12
